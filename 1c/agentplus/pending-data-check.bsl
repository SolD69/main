// =====================================================================================
// апОбменДанными: у каких торговых есть данные на загрузку (To1C.zip в папке агента).
// РОДЕН 06.11.2026. Только смотрит: ничего не скачивает, не загружает и не удаляет.
// =====================================================================================

// ---- ВСТАВКА 5. Модуль объекта, внутрь области рдн_РазбиениеЗаказовПоСкладам (перед #КонецОбласти)
//      или отдельной областью перед последним #КонецЕсли

// Возвращает ТаблицаЗначений: Агент, Папка, ЕстьДанные, Размер (байт), Изменен (время FTP-сервера), Ошибка.
// И выводит по строке на агента в протокол обмена.
Функция рдн_ДанныеНаЗагрузку() Экспорт
	
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Агент");
	Результат.Колонки.Добавить("Папка", Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("ЕстьДанные", Новый ОписаниеТипов("Булево"));
	Результат.Колонки.Добавить("Размер", Новый ОписаниеТипов("Число"));
	Результат.Колонки.Добавить("Изменен", Новый ОписаниеТипов("Дата"));
	Результат.Колонки.Добавить("Ошибка", Новый ОписаниеТипов("Строка"));
	
	ЗагрузитьНастройкиДляРаботыОбмена();
	Если Не ВременныеТаблицы.Свойство("НастройкиАгентов") Тогда
		ОповеститьОСобытии("Настройки агентов не заданы.", "ОшибкаНастройки");
		Возврат Результат;
	КонецЕсли;
	Если СпособОбмена <> "FTP" Тогда
		ОповеститьОСобытии("Проверка работает только для способа обмена FTP (сейчас: " + СпособОбмена + ").", "ОшибкаНастройки");
		Возврат Результат;
	КонецЕсли;
	
	ПодключениеКФТП = ФТПСоздатьПодключение();
	Если ПодключениеКФТП = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	ФТППапкаСервера = СтрЗаменить(FTPКаталогСервера, "\", "/");
	
	Для Каждого СтрокаАгента Из ВременныеТаблицы.НастройкиАгентов Цикл
		
		СтрокаР = Результат.Добавить();
		СтрокаР.Агент = СтрокаАгента.Пользователь;
		СтрокаР.Папка = СокрЛП(СтрокаАгента.КаталогОбмена);
		Если ПустаяСтрока(СтрокаР.Папка) Тогда
			СтрокаР.Ошибка = "не указана папка обмена";
			Продолжить;
		КонецЕсли;
		ФТППапка = ДополнитьСлешВПуть(СтрокаР.Папка, "/");
		
		Попытка
			// так же, как типовой ФТПЗагрузитьФайл()
			Если Не ПустаяСтрока(ФТППапкаСервера) И Лев(ФТППапка, 1) <> "\" Тогда
				ПодключениеКФТП.УстановитьТекущийКаталог(ФТППапкаСервера);
			КонецЕсли;
			Файлы = ПодключениеКФТП.НайтиФайлы(ФТППапка, "To1C.*");
			СтрокаР.ЕстьДанные = Файлы.Количество() > 0;
		Исключение
			СтрокаР.Ошибка = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
			Продолжить;
		КонецПопытки;
		
		Если СтрокаР.ЕстьДанные Тогда
			Попытка
				СтрокаР.Размер = Файлы[0].Размер();
				СтрокаР.Изменен = Файлы[0].ПолучитьВремяИзменения();
			Исключение
				// размер/время не все FTP-серверы отдают - не критично
			КонецПопытки;
		КонецЕсли;
		
	КонецЦикла;
	
	Результат.Сортировать("ЕстьДанные Убыв");
	
	КоличествоСДанными = 0;
	Для Каждого СтрокаР Из Результат Цикл
		Если ЗначениеЗаполнено(СтрокаР.Ошибка) Тогда
			Текст = СтрШаблон_("%1 (%2): ошибка - %3", СтрокаР.Агент, СтрокаР.Папка, СтрокаР.Ошибка);
			ОповеститьОСобытии(Текст, "ОшибкаОбмен", , СтрокаР.Агент);
		ИначеЕсли СтрокаР.ЕстьДанные Тогда
			КоличествоСДанными = КоличествоСДанными + 1;
			Текст = СтрШаблон_("%1 (%2): ЕСТЬ данные на загрузку, To1C.zip %3 КБ от %4", СтрокаР.Агент, СтрокаР.Папка,
				Формат(Окр(СтрокаР.Размер / 1024), "ЧН=0; ЧГ=0"), Формат(СтрокаР.Изменен, "ДФ='dd.MM.yyyy HH:mm'; ДП=-"));
			ОповеститьОСобытии(Текст, , , СтрокаР.Агент);
		Иначе
			Текст = СтрШаблон_("%1 (%2): нет данных", СтрокаР.Агент, СтрокаР.Папка);
			ОповеститьОСобытии(Текст, , , СтрокаР.Агент);
		КонецЕсли;
	КонецЦикла;
	ОповеститьОСобытии(СтрШаблон_("Данные на загрузку есть у %1 из %2 агентов.", КоличествоСДанными, Результат.Количество()));
	
	Возврат Результат;
	
КонецФункции


// ---- ВСТАВКА 6. Форма ОбменДанными: команда «Есть данные на загрузку?»
// 1) В форме добавить команду рдн_ДанныеНаЗагрузку (заголовок «Есть данные на загрузку?»),
//    вытащить её кнопкой рядом с «Загрузить».
// 2) В модуль формы:

&НаКлиенте
Процедура рдн_ДанныеНаЗагрузку(Команда)
	рдн_ДанныеНаЗагрузкуНаСервере();
КонецПроцедуры

&НаСервере
Процедура рдн_ДанныеНаЗагрузкуНаСервере()
	РеквизитФормыВЗначение("Объект").рдн_ДанныеНаЗагрузку();
КонецПроцедуры
