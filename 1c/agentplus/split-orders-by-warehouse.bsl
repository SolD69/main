// апОбменДанными (Агент Плюс), модуль объекта. РОДЕН 06.11.2026, ИП Конышева, УТ 11.5.27.82
// Заявка Агент+ -> несколько ЗаказКлиента по складу группы номенклатуры (рдн_Склад)
// + комментарий "#ОбменАгентПлюс ДАТАВРЕМЯ".
// Дата = текущая: кодом не делается, включить типовую настройку ЗагружатьДокументыТекущейДатой.
// =====================================================================================

// ---- ВСТАВКА 1. ЗагрузитьДокументЗаказ, сразу после строки
//	ЗаполнитьОсновныеРеквизитыДокумента(ОбъектДок, СтррЗначения, ДокМенеджер, СтррОбязательныеПоля);
	ОбъектДок.Комментарий = рдн_КомментарийОбменаАгентПлюс(СтррЗначения.Комментарий); //РОДЕН 06.11.2026 комментарий "#ОбменАгентПлюс ДАТАВРЕМЯ"

// ---- ВСТАВКА 2. ЗагрузитьДокументЗаказ, после блока «//РОДЕН ++ 03.11.2026 Склад в строках из рдн_Склад ... //РОДЕН --»,
//      перед «Если ЗагрузкаВВидеЗаказа И ПоколениеКонфигурации(">=УТ_11.3") Тогда ПроверитьЗаполнитьОбеспечениеВДокументеЗаказы»
			//РОДЕН ++ 06.11.2026 Заявка Агент+ -> несколько заказов по складам строк; в ОбъектДок остаются строки основного склада
			Если ЗагрузкаВВидеЗаказа Тогда
				рдн_РазделитьЗаказПоСкладам(ОбъектДок, СтррПараметры.ИдОбъекта, СтррПараметры.ЭтоНовый);
			КонецЕсли;
			//РОДЕН --

// ---- ВСТАВКА 3. ЗагрузитьДокументЗаказ, перед последней строкой «Возврат Результат;» (после блока ИдМерчендайзинга)
	//РОДЕН ++ 06.11.2026 Записываем остальные заказы разбивки (после основного)
	Результат = рдн_ЗаписатьЧастиЗаказа(ОбъектДок, СтррЗначения, КэшированныеЗначения, Результат);
	//РОДЕН --

// ---- ВСТАВКА 4. Конец модуля, перед последним #КонецЕсли

#Область рдн_РазбиениеЗаказовПоСкладам
// РОДЕН 06.11.2026 ИП Конышева
// Одна заявка Агент+ -> несколько ЗаказКлиента, по одному на склад в строках.
// Склад строки ставит блок РОДЕН 03.11.2026 в ЗагрузитьДокументЗаказ (рдн_Склад группы номенклатуры).
//
// Основной заказ - сам загружаемый документ: ссылка = GUID заявки, по ней идут подтверждения на телефон.
// Остальные заказы (части) - ссылка = MD5("АгентПлюс|GUID заявки|GUID склада"):
// при повторной загрузке той же заявки находятся и перезаписываются, дублей нет.
// Часть, склада которой больше нет в заявке, помечается на удаление.

// Вызывается после цикла по строкам, до обеспечения/скидок/записи.
// В ОбъектДок остаются строки основного склада, объекты частей кладутся в
// ОбъектДок.ДополнительныеСвойства.рдн_РазбиениеЗаказа и записываются в рдн_ЗаписатьЧастиЗаказа.
Процедура рдн_РазделитьЗаказПоСкладам(ОбъектДок, ИдЗаявки, ЭтоНовыйЗаказ)
	
	Части = Новый Массив;
	ОбъектДок.ДополнительныеСвойства.Вставить("рдн_РазбиениеЗаказа",
		Новый Структура("ИдЗаявки, ЭтоНовый, Части", ИдЗаявки, ЭтоНовыйЗаказ, Части));
	
	ТаблицаТоваров = ОбъектДок.Товары.Выгрузить();
	Склады = Новый Массив;
	Для Каждого СтрокаТовары Из ТаблицаТоваров Цикл
		Если Не ЗначениеЗаполнено(СтрокаТовары.Склад) Тогда
			СтрокаТовары.Склад = ОбъектДок.Склад;
		КонецЕсли;
		Если Склады.Найти(СтрокаТовары.Склад) = Неопределено Тогда
			Склады.Добавить(СтрокаТовары.Склад);
		КонецЕсли;
	КонецЦикла;
	
	Если Склады.Количество() < 2 Тогда
		Возврат; // разбивать нечего; старые части (если были) пометятся в рдн_ЗаписатьЧастиЗаказа
	КонецЕсли;
	
	// Основной заказ - склад шапки, если по нему есть товар, иначе склад первой строки
	ИндексОсновного = Склады.Найти(ОбъектДок.Склад);
	Если ИндексОсновного = Неопределено Тогда
		ИндексОсновного = 0;
	КонецЕсли;
	СкладОсновной = Склады[ИндексОсновного];
	Склады.Удалить(ИндексОсновного);
	
	ИмяДокумента = ОбъектДок.Метаданные().Имя;
	МенеджерДок = Документы[ИмяДокумента];
	ИменаРеквизитов = рдн_ИменаРеквизитовШапки(ОбъектДок);
	
	Для Каждого Склад Из Склады Цикл
		СсылкаЧасти = МенеджерДок.ПолучитьСсылку(рдн_ИдентификаторЧастиЗаказа(ИдЗаявки, Склад));
		Часть = СсылкаЧасти.ПолучитьОбъект();
		Если Часть = Неопределено Тогда
			Часть = МенеджерДок.СоздатьДокумент();
			Часть.УстановитьСсылкуНового(СсылкаЧасти);
			Часть.Дата = ОбъектДок.Дата;
		КонецЕсли;
		ЗаполнитьЗначенияСвойств(Часть, ОбъектДок, ИменаРеквизитов);
		Часть.ПометкаУдаления = ОбъектДок.ПометкаУдаления;
		Часть.ДополнительныеСвойства.Вставить("ОтключитьЗаполнениеОбъектаПоСтатистике", Истина);
		рдн_ЗаполнитьЧастьЗаказа(Часть, Склад, ТаблицаТоваров);
		Части.Добавить(Часть);
	КонецЦикла;
	
	рдн_ЗаполнитьЧастьЗаказа(ОбъектДок, СкладОсновной, ТаблицаТоваров);
	
КонецПроцедуры

// Вызывается в конце ЗагрузитьДокументЗаказ, после записи основного заказа.
// Обрабатывает части так же, как типовой код - основной заказ (обеспечение, серии, этапы оплаты,
// валюта, скидки), и записывает их. Возвращает Ложь, если основной заказ или хотя бы одна часть не записаны.
Функция рдн_ЗаписатьЧастиЗаказа(ОбъектДок, СтррЗначения, КэшированныеЗначения, РезультатОсновного)
	
	Разбиение = Неопределено;
	Если Не ОбъектДок.ДополнительныеСвойства.Свойство("рдн_РазбиениеЗаказа", Разбиение) Тогда
		Возврат РезультатОсновного;
	КонецЕсли;
	Если Не РезультатОсновного Тогда
		Возврат Ложь; // основной заказ не записан - части не пишем, заявка будет загружена повторно
	КонецЕсли;
	
	Результат = Истина;
	ПредставлениеЗаказов = Строка(ОбъектДок.Ссылка) + " (" + Строка(ОбъектДок.Склад) + ")";
	
	Для Каждого Часть Из Разбиение.Части Цикл
		
		Если ПоколениеКонфигурации(">=УТ_11.3") Тогда
			ПроверитьЗаполнитьОбеспечениеВДокументеЗаказы(Часть);
			МодульНоменклатураСервер = ОбщегоНазначения.ОбщийМодуль("НоменклатураСервер");
			СтррПараметрыУказанияСерий = Новый ФиксированнаяСтруктура(МодульНоменклатураСервер.ПараметрыУказанияСерий(Часть, Документы.ЗаказКлиента));
			МодульНоменклатураСервер.ЗаполнитьСтатусыУказанияСерий(Часть, СтррПараметрыУказанияСерий);
		КонецЕсли;
		
		ДокументПродажиЗаполнитьЭтапыГрафикаОплаты(Часть);
		ПересчитатьДокументВВалютуСоглашенияЗаказа(Часть);
		
		СтррПараметрыРасчетаСкидок = Новый Структура;
		СтррПараметрыРасчетаСкидок.Вставить("ПрименятьКОбъекту",                Истина);
		СтррПараметрыРасчетаСкидок.Вставить("ТолькоПредварительныйРасчет",      Ложь);
		СтррПараметрыРасчетаСкидок.Вставить("ВосстанавливатьУправляемыеСкидки", Истина);
		СтррПараметрыРасчетаСкидок.Вставить("УправляемыеСкидки",                Неопределено);
		РассчитатьСкидкиПоРежиму(Часть, СтррПараметрыРасчетаСкидок, КэшированныеЗначения);
		Часть.СуммаДокумента = Часть.Товары.Итог("СуммаСНДС");
		
		Если ЗаписьДокумента(Часть, СтррЗначения, Часть.ЭтоНовый()) Тогда
			ПредставлениеЗаказов = ПредставлениеЗаказов + ", " + Строка(Часть.Ссылка) + " (" + Строка(Часть.Склад) + ")";
		Иначе
			Результат = Ложь;
		КонецЕсли;
		
	КонецЦикла;
	
	Если Не Разбиение.ЭтоНовый Тогда
		рдн_ПометитьУстаревшиеЧастиЗаказа(ОбъектДок, Разбиение);
	КонецЕсли;
	
	Если Разбиение.Части.Количество() > 0 Тогда
		Текст = СтрШаблон_("Заявка Агент+ разбита по складам на %1: %2.",
			ЧислоЦифрамиПредметИсчисленияПрописью(Разбиение.Части.Количество() + 1, "заказ,заказа,заказов"), ПредставлениеЗаказов);
		ОповеститьОСобытии(Текст, , ОбъектДок.Ссылка, "ТекущийАгент");
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Повторная загрузка: часть, склада которой больше нет в заявке, помечается на удаление.
Процедура рдн_ПометитьУстаревшиеЧастиЗаказа(ОбъектДок, Разбиение)
	
	ИмяДокумента = ОбъектДок.Метаданные().Имя;
	МенеджерДок = Документы[ИмяДокумента];
	
	АктуальныеЧасти = Новый Массив;
	Для Каждого Часть Из Разбиение.Части Цикл
		АктуальныеЧасти.Добавить(Часть.Ссылка);
	КонецЦикла;
	
	Кандидаты = Новый Массив;
	ЗапросСкладов = Новый Запрос("ВЫБРАТЬ Склады.Ссылка КАК Ссылка ИЗ Справочник.Склады КАК Склады");
	ВыборкаСкладов = ЗапросСкладов.Выполнить().Выбрать();
	Пока ВыборкаСкладов.Следующий() Цикл
		СсылкаЧасти = МенеджерДок.ПолучитьСсылку(рдн_ИдентификаторЧастиЗаказа(Разбиение.ИдЗаявки, ВыборкаСкладов.Ссылка));
		Если АктуальныеЧасти.Найти(СсылкаЧасти) = Неопределено Тогда
			Кандидаты.Добавить(СсылкаЧасти);
		КонецЕсли;
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ Док.Ссылка КАК Ссылка ИЗ Документ." + ИмяДокумента + " КАК Док ГДЕ Док.Ссылка В (&Кандидаты) И НЕ Док.ПометкаУдаления";
	Запрос.УстановитьПараметр("Кандидаты", Кандидаты);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Попытка
			Выборка.Ссылка.ПолучитьОбъект().УстановитьПометкуУдаления(Истина);
			Текст = "Заказ " + Строка(Выборка.Ссылка) + " помечен на удаление: его склада больше нет в заявке Агент+ " + Строка(ОбъектДок.Ссылка) + ".";
			ОповеститьОСобытии(Текст, , Выборка.Ссылка, "ТекущийАгент");
		Исключение
			Текст = "Не удалось пометить на удаление заказ " + Строка(Выборка.Ссылка) + ": " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
			ОповеститьОСобытии(Текст, "ОшибкаЗапись", Выборка.Ссылка, "ТекущийАгент");
		КонецПопытки;
	КонецЦикла;
	
КонецПроцедуры

Процедура рдн_ЗаполнитьЧастьЗаказа(Документ, Склад, ТаблицаТоваров)
	Документ.Склад = Склад;
	Документ.Товары.Загрузить(ТаблицаТоваров.Скопировать(Новый Структура("Склад", Склад)));
КонецПроцедуры

Функция рдн_ИменаРеквизитовШапки(ОбъектДок)
	Имена = Новый Массив;
	Для Каждого Реквизит Из ОбъектДок.Метаданные().Реквизиты Цикл
		Имена.Добавить(Реквизит.Имя);
	КонецЦикла;
	Возврат СтрСоединить_(Имена, ",");
КонецФункции

// GUID части = MD5("АгентПлюс|<GUID заявки>|<GUID склада>") - одинаковый при каждой загрузке
Функция рдн_ИдентификаторЧастиЗаказа(ИдЗаявки, Склад)
	Хеш = Новый ХешированиеДанных(ХешФункция.MD5);
	Хеш.Добавить("АгентПлюс|" + НРег(Строка(ИдЗаявки)) + "|" + НРег(Строка(Склад.УникальныйИдентификатор())));
	Hex = НРег(ПолучитьHexСтрокуИзДвоичныхДанных(Хеш.ХешСумма));
	Возврат Новый УникальныйИдентификатор(Сред(Hex, 1, 8) + "-" + Сред(Hex, 9, 4) + "-" + Сред(Hex, 13, 4) + "-" + Сред(Hex, 17, 4) + "-" + Сред(Hex, 21, 12));
КонецФункции

// "#ОбменАгентПлюс 06.11.2026 14:05:31", комментарий агента (если есть) - со второй строки.
// Если нужен строго только тег - удалить блок "Если ТекстАгента <> """.
Функция рдн_КомментарийОбменаАгентПлюс(КомментарийАгента)
	Результат = "#ОбменАгентПлюс " + Формат(ТекущаяДатаСеанса(), "ДФ='dd.MM.yyyy HH:mm:ss'");
	ТекстАгента = СокрЛП(Строка(КомментарийАгента));
	Если ТекстАгента <> "" Тогда
		Результат = Результат + Символы.ПС + ТекстАгента;
	КонецЕсли;
	Возврат Результат;
КонецФункции

#КонецОбласти
