// =====================================================================================
// Обработка обмена «Агент Плюс: Мобильная торговля» (УТ 11) — модуль объекта
// РОДЕН 06.11.2026
//   1) Одна заявка Агент+ -> несколько Заказов клиента по складу группы номенклатуры (рдн_Склад)
//   2) Новые заказы записываются текущей датой
//   3) Комментарий заказа: "#ОбменАгентПлюс ДД.ММ.ГГГГ ЧЧ:ММ:СС" (+ комментарий агента со 2-й строки)
//
// Три правки модуля объекта. Порядок вставки — см. README.md рядом.
// =====================================================================================


// -------------------------------------------------------------------------------------
// ИЗМЕНЕНИЕ 1. Функция ЗагрузитьДокументЗаказ — дата документа
// -------------------------------------------------------------------------------------
// БЫЛО (одна строка):
//
//	ЗаполнитьОсновныеРеквизитыДокумента(ОбъектДок, СтррЗначения, ДокМенеджер, СтррОбязательныеПоля);
//
// СТАЛО:

	ДатаДоЗагрузки = ОбъектДок.Дата; //РОДЕН 06.11.2026
	ЗаполнитьОсновныеРеквизитыДокумента(ОбъектДок, СтррЗначения, ДокМенеджер, СтррОбязательныеПоля);
	//РОДЕН ++ 06.11.2026 Заказ из Агент+ записываем текущей датой (при повторной загрузке дату не трогаем)
	Если СтррПараметры.ЭтоНовый Или Не ЗначениеЗаполнено(ДатаДоЗагрузки) Тогда
		ОбъектДок.Дата = ТекущаяДатаСеанса();
	Иначе
		ОбъектДок.Дата = ДатаДоЗагрузки;
	КонецЕсли;
	//РОДЕН --


// -------------------------------------------------------------------------------------
// ИЗМЕНЕНИЕ 2. Функция ЗагрузитьДокументЗаказ — хвост функции
// -------------------------------------------------------------------------------------
// Заменить ВСЁ от конца цикла по строкам табличной части
// (КонецЦикла; сразу после «НоваяСтрока.ВариантОбеспечения = ВариантОбеспечения; КонецЕсли;»)
// до КонецФункции включительно. Удаляется:
//   - старый блок «//РОДЕН ++ 03.11.2026 Склад в строках из рдн_Склад ...»;
//   - заполнение обеспечения и статусов серий внутри обработки TABLES;
//   - этапы графика оплаты, пересчёт валюты, расчёт скидок, СуммаВзаиморасчетов,
//     вызов ЗаписьДокумента(ОбъектДок, ...).
// Всё это теперь делается для каждой части заказа в цикле ниже.
//
// СТАЛО:

			КонецЦикла;

		КонецЕсли;
	КонецЕсли;

	//РОДЕН ++ 06.11.2026 Одна заявка Агент+ -> несколько заказов по складу группы номенклатуры (рдн_Склад)
	ЧастиЗаказа = рдн_РазделитьЗаказПоСкладам(ОбъектДок, СтррПараметры.ИдОбъекта);
	КомментарийОбмена = рдн_КомментарийОбменаАгентПлюс(СтррЗначения.Комментарий);
	Результат = Истина;
	Для Каждого ДокЧасть Из ЧастиЗаказа Цикл
		ДокЧасть.Комментарий = КомментарийОбмена;
		ДокЧасть.СуммаДокумента = ДокЧасть.Товары.Итог("СуммаСНДС");
		Если ЗагрузкаВВидеЗаказа И ПоколениеКонфигурации(">=УТ_11.3") Тогда
			ПроверитьЗаполнитьОбеспечениеВДокументеЗаказы(ДокЧасть);
		КонецЕсли;
		Если ПоколениеКонфигурации(">=УТ_11.3") Тогда
			МодульНоменклатураСервер = ОбщегоНазначения.ОбщийМодуль("НоменклатураСервер");
			СтррПараметрыУказанияСерий = Новый ФиксированнаяСтруктура(МодульНоменклатураСервер.ПараметрыУказанияСерий(ДокЧасть, ?(ЗагрузкаВВидеЗаказа, Документы.ЗаказКлиента, Документы.РеализацияТоваровУслуг)));
			МодульНоменклатураСервер.ЗаполнитьСтатусыУказанияСерий(ДокЧасть, СтррПараметрыУказанияСерий);
		КонецЕсли;
		Если Не ЗагрузкаВВидеЗаказа Тогда
			СтррОтветственный = ДокументПродажиПолучитьОтветственногоПоСкладу(ДокЧасть);
			Если СтррОтветственный <> Неопределено Тогда
				ДокЧасть.Отпустил = СтррОтветственный.Ответственный;
				ДокЧасть.ОтпустилДолжность = СтррОтветственный.ОтветственныйДолжность;
			КонецЕсли;
		КонецЕсли;
		ДокументПродажиЗаполнитьЭтапыГрафикаОплаты(ДокЧасть);
		ПересчитатьДокументВВалютуСоглашенияЗаказа(ДокЧасть);
		СтррПараметрыРасчетаСкидок = Новый Структура;
		СтррПараметрыРасчетаСкидок.Вставить("ПрименятьКОбъекту", Истина);
		СтррПараметрыРасчетаСкидок.Вставить("ТолькоПредварительныйРасчет", Ложь);
		СтррПараметрыРасчетаСкидок.Вставить("ВосстанавливатьУправляемыеСкидки", Истина);
		СтррПараметрыРасчетаСкидок.Вставить("УправляемыеСкидки", Неопределено);
		Если Не ЗагрузкаВВидеЗаказа Тогда
			СтррПараметрыРасчетаСкидок.Вставить("РеализацияСверхЗаказа", Ложь);
		КонецЕсли;
		РассчитатьСкидкиПоРежиму(ДокЧасть, СтррПараметрыРасчетаСкидок, КэшированныеЗначения);
		ДокЧасть.СуммаДокумента = ДокЧасть.Товары.Итог("СуммаСНДС");
		Если Не ЗагрузкаВВидеЗаказа И ДокЧасть.Валюта = ДокЧасть.ВалютаВзаиморасчетов Тогда
			ДокЧасть.СуммаВзаиморасчетов = ДокЧасть.СуммаДокумента;
		КонецЕсли;
		РезультатЧасти = ЗаписьДокумента(ДокЧасть, СтррЗначения, ДокЧасть.ЭтоНовый());
		Если РезультатЧасти И ДокЧасть.ПометкаУдаления Тогда
			Текст = "На основании документа """ + Строка(ДокЧасть.Ссылка) + """ не будет создан документ ""Реализация товаров и услуг"", т.к. он помечен на удаление.";
			ОповеститьОСобытии(Текст, "ОшибкаЗапись", ДокЧасть.Ссылка, "ТекущийАгент");
		КонецЕсли;
		Результат = Результат И РезультатЧасти;
	КонецЦикла;
	//РОДЕН --

	Если ЗначениеЗаполнено(ОбъектДок.Ссылка) И ЗначениеЗаполнено(ИдМерчендайзинга) Тогда
		СтрокаТ = ЗагружаемыеОбъекты.тзСсылкиНаМерчендайзинг.Добавить();
		СтрокаТ.Документ		 = ОбъектДок.Ссылка;
		СтрокаТ.ИдМерчендайзинга = ИдМерчендайзинга;
	КонецЕсли;

	Возврат Результат;

КонецФункции


// -------------------------------------------------------------------------------------
// ИЗМЕНЕНИЕ 3. Новая область — в конец модуля, ПЕРЕД последним #КонецЕсли
// (после «#Область МаркировкаПоКазахстану ... #КонецОбласти»)
// -------------------------------------------------------------------------------------

#Область рдн_РазбиениеЗаказовПоСкладам
// РОДЕН 06.11.2026

// Делит загружаемый заказ по складам номенклатуры (рдн_Продажи.СкладыНоменклатуры).
// Первая часть — сам ОбъектДок (сохраняет GUID заявки Агент+, нужен для подтверждений).
// Остальные части получают детерминированный GUID (заявка + склад), поэтому повторная
// загрузка той же заявки обновляет их, а не создаёт дубли.
//
// Возвращает: Массив ДокументОбъект — все части, ОбъектДок всегда первый.
Функция рдн_РазделитьЗаказПоСкладам(ОбъектДок, ИдЗаявки)
	Части = Новый Массив;
	Части.Добавить(ОбъектДок);
	Если ОбъектДок.Товары.Количество() = 0 Тогда
		Возврат Части;
	КонецЕсли;
	ТаблицаТоваров = ОбъектДок.Товары.Выгрузить();
	СкладыНоменклатуры = рдн_Продажи.СкладыНоменклатуры(ТаблицаТоваров.ВыгрузитьКолонку("Номенклатура"));
	Склады = Новый Массив;
	Для Каждого СтрокаТовары Из ТаблицаТоваров Цикл
		СкладНоменклатуры = СкладыНоменклатуры.Получить(СтрокаТовары.Номенклатура);
		Если ЗначениеЗаполнено(СкладНоменклатуры) Тогда
			СтрокаТовары.Склад = СкладНоменклатуры;
		ИначеЕсли Не ЗначениеЗаполнено(СтрокаТовары.Склад) Тогда
			СтрокаТовары.Склад = ОбъектДок.Склад;
		КонецЕсли;
		Если Склады.Найти(СтрокаТовары.Склад) = Неопределено Тогда
			Склады.Добавить(СтрокаТовары.Склад);
		КонецЕсли;
	КонецЦикла;
	// Основная часть — склад шапки заказа, если на нём есть товар, иначе первый найденный
	ИндексОсновного = Склады.Найти(ОбъектДок.Склад);
	Если ИндексОсновного = Неопределено Тогда
		ИндексОсновного = 0;
	КонецЕсли;
	СкладОсновной = Склады[ИндексОсновного];
	Склады.Удалить(ИндексОсновного);
	рдн_ЗаполнитьЧастьЗаказа(ОбъектДок, СкладОсновной, ТаблицаТоваров);
	Если Склады.Количество() = 0 Тогда
		Возврат Части;
	КонецЕсли;
	МенеджерДок = Документы[ОбъектДок.Метаданные().Имя];
	ИменаРеквизитов = рдн_ИменаРеквизитовШапки(ОбъектДок);
	ПредставлениеСкладов = Строка(СкладОсновной);
	Для Каждого Склад Из Склады Цикл
		СсылкаЧасти = МенеджерДок.ПолучитьСсылку(рдн_ИдентификаторЧастиЗаказа(ИдЗаявки, Склад));
		Часть = СсылкаЧасти.ПолучитьОбъект();
		Если Часть = Неопределено Тогда
			Часть = ОбъектДок.Скопировать();
			Часть.УстановитьСсылкуНового(СсылкаЧасти);
			Часть.Номер = "";
		Иначе
			ЗаполнитьЗначенияСвойств(Часть, ОбъектДок, ИменаРеквизитов);
		КонецЕсли;
		Часть.ДополнительныеСвойства.Вставить("ОтключитьЗаполнениеОбъектаПоСтатистике", Истина);
		рдн_ЗаполнитьЧастьЗаказа(Часть, Склад, ТаблицаТоваров);
		Части.Добавить(Часть);
		ПредставлениеСкладов = ПредставлениеСкладов + ", " + Строка(Склад);
	КонецЦикла;
	Текст = СтрШаблон_("Заявка разбита по складам на %1: %2.",
		ЧислоЦифрамиПредметИсчисленияПрописью(Части.Количество(), "заказ,заказа,заказов"), ПредставлениеСкладов);
	ОповеститьОСобытии(Текст,,, "ТекущийАгент");
	Возврат Части;
КонецФункции

Процедура рдн_ЗаполнитьЧастьЗаказа(Документ, Склад, ТаблицаТоваров)
	Документ.Склад = Склад;
	Документ.Товары.Загрузить(ТаблицаТоваров.Скопировать(Новый Структура("Склад", Склад)));
КонецПроцедуры

Функция рдн_ИменаРеквизитовШапки(ОбъектДок)
	Имена = Новый Массив;
	Для Каждого Реквизит Из ОбъектДок.Метаданные().Реквизиты Цикл
		Имена.Добавить(Реквизит.Имя);
	КонецЦикла;
	Возврат СтрСоединить_(Имена, ",");
КонецФункции

// GUID части = MD5("АгентПлюс|<GUID заявки>|<GUID склада>") — одинаковый при каждой загрузке
Функция рдн_ИдентификаторЧастиЗаказа(ИдЗаявки, Склад)
	Хеш = Новый ХешированиеДанных(ХешФункция.MD5);
	Хеш.Добавить("АгентПлюс|" + НРег(Строка(ИдЗаявки)) + "|" + НРег(Строка(Склад.УникальныйИдентификатор())));
	Hex = НРег(ПолучитьHexСтрокуИзДвоичныхДанных(Хеш.ХешСумма));
	Возврат Новый УникальныйИдентификатор(Сред(Hex,1,8)+"-"+Сред(Hex,9,4)+"-"+Сред(Hex,13,4)+"-"+Сред(Hex,17,4)+"-"+Сред(Hex,21,12));
КонецФункции

// "#ОбменАгентПлюс 06.11.2026 14:05:31" + комментарий агента со второй строки (если есть).
// Нужен строго только тег — удалите блок «Если ТекстАгента <> ""».
Функция рдн_КомментарийОбменаАгентПлюс(КомментарийАгента)
	Результат = "#ОбменАгентПлюс " + Формат(ТекущаяДатаСеанса(), "ДФ='dd.MM.yyyy HH:mm:ss'");
	ТекстАгента = СокрЛП(Строка(КомментарийАгента));
	Если ТекстАгента <> "" Тогда
		Результат = Результат + Символы.ПС + ТекстАгента;
	КонецЕсли;
	Возврат Результат;
КонецФункции
#КонецОбласти
